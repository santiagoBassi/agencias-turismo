# Copiá este archivo a .env y completá tu API key.
# Se consigue en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo a usar para el parseo. Cambiar acá para comparar costo/calidad sin
# tocar código. Precios oficiales por 1M tokens (USD) a la fecha de esta POC
# (ai.google.dev/gemini-api/docs/pricing) -- OJO: "gemini-2.5-flash" y
# "gemini-2.5-flash-lite" ya NO están disponibles para API keys nuevas, la API
# devuelve 404 y sugiere migrar a la familia 3.x:
#   gemini-3.1-flash-lite  -> entrada 0.25 / salida 1.50  (default: el más barato, sin "thinking" por default)
#   gemini-3.5-flash-lite  -> entrada 0.30 / salida 2.50
#   gemini-3.5-flash       -> entrada 1.50 / salida 9.00  (razona por default: más caro de lo que parece)
#   gemini-3.6-flash       -> entrada 0.75 / salida 3.75  (razona por default)
# Los modelos que "razonan" por default consumen tokens de thinking que se
# facturan como salida aunque no aparezcan en el texto de respuesta -- parseo.py
# ya los suma al costo medido.
GEMINI_MODEL=gemini-3.1-flash-lite

# Precio por millón de tokens en USD. Si no se setean, se usa la tabla
# hardcodeada en parseo.py para el modelo elegido.
GEMINI_PRECIO_IN=
GEMINI_PRECIO_OUT=
